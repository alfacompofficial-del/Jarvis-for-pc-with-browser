<Window x:Class="Jarvis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis" Height="700" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">
    
    <Border Background="#2D2D30" CornerRadius="15" BorderBrush="#007ACC" BorderThickness="2">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="🤖 JARVIS" FontSize="20" FontWeight="Bold" Foreground="#007ACC" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Готов" FontSize="14" Foreground="#4EC9B0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Button Content="✖" Click="CloseButton_Click" 
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        FontSize="16" Width="30" Height="30" 
                        HorizontalAlignment="Right" Margin="150,0,0,0"
                        Cursor="Hand"/>
            </StackPanel>

            <!-- 🤖 АНИМИРОВАННАЯ АВАТАРКА JARVIS -->
            <Grid Grid.Row="1" Height="120" Margin="0,10">
                <!-- Внешнее кольцо - статус -->
                <Ellipse x:Name="AvatarRing" 
                         Width="100" Height="100"
                         Stroke="#007ACC" 
                         StrokeThickness="3"
                         Fill="Transparent"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="RingRotation"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                
                <!-- Основной круг аватара -->
                <Ellipse x:Name="AvatarCircle" 
                         Width="80" Height="80"
                         Fill="#1E1E1E"
                         Stroke="#4EC9B0"
                         StrokeThickness="2"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="CircleScale"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                
                <!-- Иконка глаз Jarvis -->
                <TextBlock x:Name="AvatarEye" 
                           Text="👁️"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#007ACC">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="EyeScale"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                
                <!-- Анимация речи - волны -->
                <Canvas x:Name="SpeechWaves" 
                        Width="120" Height="120"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0">
                    <Ellipse Width="120" Height="120" 
                             Stroke="#4EC9B0" 
                             StrokeThickness="2" 
                             Fill="Transparent"
                             Canvas.Left="-10" Canvas.Top="-10"/>
                    <Ellipse Width="140" Height="140" 
                             Stroke="#007ACC" 
                             StrokeThickness="1" 
                             Fill="Transparent"
                             Canvas.Left="-20" Canvas.Top="-20"/>
                </Canvas>
                
                <!-- Статус индикатор -->
                <TextBlock x:Name="StatusIndicator"
                           Text="💤"
                           FontSize="16"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,10,10,0"/>
            </Grid>

            <!-- 📑 ВКЛАДКИ JARVIS -->
            <TabControl Grid.Row="2" Height="40" Background="#1E1E1E" BorderThickness="0" Margin="0,10">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="15,8"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                            BorderThickness="0" CornerRadius="5,5,0,0" Margin="2,0">
                                        <ContentPresenter ContentSource="Header" 
                                                        HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#4EC9B0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                
                <TabItem Header="💬 Чат">
                    <Grid Background="Transparent"/>
                </TabItem>
                <TabItem Header="🤖 Макросы">
                    <Grid Background="Transparent"/>
                </TabItem>
                <TabItem Header="⏰ Задачи">
                    <Grid Background="Transparent"/>
                </TabItem>
                <TabItem Header="🌐 PWA">
                    <Grid Background="Transparent"/>
                </TabItem>
            </TabControl>

            <!-- Chat Display -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
                <TextBlock x:Name="ChatDisplay" 
                           Text="Привет! Я Jarvis. Чем могу помочь?"
                           TextWrapping="Wrap" 
                           Foreground="White" 
                           FontSize="14"
                           Padding="5"/>
            </ScrollViewer>

            <!-- Input Box -->
            <TextBox x:Name="InputBox" 
                     Grid.Row="4"
                     Height="40" 
                     Background="#1E1E1E" 
                     Foreground="White"
                     BorderBrush="#007ACC"
                     BorderThickness="1"
                     Padding="10"
                     FontSize="14"
                     KeyDown="InputBox_KeyDown"
                     Text="Напишите команду..."/>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="🎤 Говорить" Click="VoiceButton_Click"
                        Background="#007ACC" Foreground="White" 
                        Padding="15,8" Margin="5" FontSize="12"
                        BorderThickness="0" Cursor="Hand"/>
                <Button Content="📤 Отправить" Click="SendButton_Click"
                        Background="#4EC9B0" Foreground="White" 
                        Padding="15,8" Margin="5" FontSize="12"
                        BorderThickness="0" Cursor="Hand"/>
                <Button Content="🌐 PWA" Click="PWAButton_Click"
                        Background="#FF6B6B" Foreground="White" 
                        Padding="15,8" Margin="5" FontSize="12"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
